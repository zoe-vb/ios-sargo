+/*
+ * Timer heartbeat (sweet_boot_progress, patch 0082): every virtual timer
+ * IRQ repaints a 48x48 square in the top right corner with a new colour.
+ * A changing corner = timer interrupts arrive; a frozen one = they don't.
+ * Called from the IRQ handler: a few aligned stores, no locks.
+ */
+extern uint32_t sweet_timer_irqs;
+uint32_t sweet_timer_irqs;
+
+void sweet_timer_heartbeat(void);
+
+void
+sweet_timer_heartbeat(void)
+{
+	uint32_t n = __atomic_add_fetch(&sweet_timer_irqs, 1, __ATOMIC_RELAXED);
+	if (fbcon_base == NULL || fbcon_width < 64) {
+		return;
+	}
+	uint32_t colour = 0xff000000u | ((n * 0x9e3779b9u) & 0x00ffffffu) | 0x00404040u;
+	for (uint32_t y = 8; y < 56; y++) {
+		volatile uint32_t *line = fbcon_base + y * (fbcon_stride / 4);
+		for (uint32_t x = fbcon_width - 56; x < fbcon_width - 8; x++) {
+			line[x] = colour;
+		}
+	}
+}
