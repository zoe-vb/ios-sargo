+/*
+ * boot-arg sdhcwtest=1: one sector WTEST_OFFSET into the partition (past the
+ * end of the 16 GiB root image): save it, write a pattern, read it back,
+ * write the saved contents back, read them back. Lock held by the caller.
+ */
+static void
+sd_write_test(void)
+{
+	uint64_t lba = sd.first + WTEST_OFFSET / SECTOR;
+	uint8_t saved[SECTOR], pattern[SECTOR];
+	uint8_t *b = (uint8_t *)(sd.dma + DMA_BOUNCE);
+
+	if (!sd.writable) {
+		printf("SWEET SDHC: write test needs sdhcrw=1\n");
+		return;
+	}
+	if (WTEST_OFFSET / SECTOR >= sd.nsectors) {
+		printf("SWEET SDHC: write test sector outside the partition\n");
+		return;
+	}
+	for (unsigned i = 0; i < SECTOR; i++) {
+		pattern[i] = (uint8_t)(i * 7 + 0x5a);
+	}
+	memcpy(pattern, "SWEET SDHC write test", 21);
+
+	int error = sd_read_sectors(lba, 1);
+	if (!error) {
+		memcpy(saved, b, SECTOR);
+		memcpy(b, pattern, SECTOR);
+		error = sd_write_sectors(lba, 1);
+	}
+	bool same = false;
+	if (!error && !(error = sd_read_sectors(lba, 1))) {
+		same = memcmp(b, pattern, SECTOR) == 0;
+	}
+	printf("SWEET SDHC: write test at sector 0x%llx: write+read %d, pattern %s\n",
+	    lba, error, same ? "matches" : "DIFFERS");
+	if (error) {
+		return;
+	}
+	memcpy(b, saved, SECTOR);
+	error = sd_write_sectors(lba, 1);
+	if (!error) {
+		error = sd_flush();
+	}
+	same = false;
+	if (!error && !(error = sd_read_sectors(lba, 1))) {
+		same = memcmp(b, saved, SECTOR) == 0;
+	}
+	printf("SWEET SDHC: write test: old contents restored %d, %s\n",
+	    error, same ? "verified" : "NOT verified");
+}
