+/*
+ * The only place data goes to the card: card sectors [lba, lba + count) from
+ * the bounce buffer. The whole range must lie inside the partition.
+ */
+static int
+sd_write_sectors(uint64_t lba, uint32_t count)
+{
+	if (!sd.writable || !sd.nsectors || count == 0 || count > XFER_MAX / SECTOR ||
+	    lba < sd.first || lba - sd.first >= sd.nsectors ||
+	    count > sd.nsectors - (lba - sd.first) || lba + count > sd.card_sectors ||
+	    lba + count - 1 > UINT32_MAX) {
+		printf("SWEET SDHC: refusing write of %u sectors at 0x%llx\n", count, lba);
+		return EPERM;
+	}
+	return sd_xfer(count > 1 ? 25 : 24, (uint32_t)lba, count, true);
+}
