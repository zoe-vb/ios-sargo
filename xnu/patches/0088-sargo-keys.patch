+/* ---- keys ---- */
+
+static uint16_t key_pon = ST_NO_APID, key_volup = ST_NO_APID;
+
+static void
+keys_init(void)
+{
+	int enabled = 1;
+	uint32_t owner;
+	(void)PE_parse_boot_argn("sargokeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET SARGO KEYS: disabled (sargokeys=0)\n");
+		return;
+	}
+	key_pon = spmi_apid(ST_PON_PPID, &owner);
+	uint8_t sub = 0, mode = 0, en = 0;
+	vm_offset_t chnl = spmi_gpio_chnl(ST_VOLUP_PPID, "PM660L GPIO 7", &key_volup, &sub);
+	if (key_volup != ST_NO_APID) {
+		spmi_read(key_volup, 0x40, &mode);
+		spmi_read(key_volup, 0x46, &en);
+	}
+	/* input: LV/MV mode bits [1:0] = 0, older subtypes mode bits [6:4] = 0 */
+	bool input = (en & 0x80u) && (sub >= 0x10 ? (mode & 3u) == 0 : ((mode >> 4) & 7u) == 0);
+	printf("SWEET SARGO KEYS: pon apid %u, vol-up apid %u subtype %#x mode %#x en %#x\n",
+	    key_pon, key_volup, sub, mode, en);
+	if (!input && chnl) {
+		int err = spmi_write(chnl, 0x40, 0x00) | spmi_write(chnl, 0x41, 0x00) |
+		    spmi_write(chnl, 0x42, 0x00) | spmi_write(chnl, 0x46, 0x80);
+		spmi_read(key_volup, 0x40, &mode);
+		spmi_read(key_volup, 0x46, &en);
+		printf("SWEET SARGO KEYS: vol-up set to input, pull-up: err %d mode %#x en %#x\n",
+		    err, mode, en);
+	} else if (!input) {
+		key_volup = ST_NO_APID;
+	}
+}
+
+static void
+keys_poll(void)
+{
+	static int state[3];
+	uint8_t pon = 0, gpio = 0;
+	bool pok = key_pon != ST_NO_APID && !spmi_read(key_pon, 0x10, &pon);
+	bool gok = key_volup != ST_NO_APID && !spmi_read(key_volup, 0x10, &gpio);
+	/* 0 power, 1 volume up, 2 volume down (sweet_hid_key) */
+	int now[3] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u)};
+	bool ok[3] = {pok, gok, pok};
+	for (int k = 0; k < 3; k++) {
+		if (ok[k] && now[k] != state[k]) {
+			state[k] = now[k];
+			printf("SWEET SARGO KEYS: key=%d down=%d\n", k, state[k]);
+			sweet_hid_key(k, state[k]);
+		}
+	}
+}
