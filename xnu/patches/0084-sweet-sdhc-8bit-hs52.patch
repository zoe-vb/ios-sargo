+/* CMD6 SWITCH (write byte) of one EXT_CSD mode byte, then CMD13 until tran without SWITCH_ERROR. */
 static int
+mmc_switch(unsigned index, unsigned value)
+{
+	int error = sd_cmd(6, 3u << 24 | index << 16 | value << 8, R1B, 0);
+	if (error) {
+		return error;
+	}
+	uint64_t end = deadline_ms(500);
+	for (;;) {
+		if ((error = sd_cmd(13, RCA << 16, R1, 0))) {
+			return error;
+		}
+		uint32_t r1 = sd_rd(SDHCI_RESPONSE);
+		if (r1 & R1_SWITCH_ERROR) {
+			printf("SWEET SDHC: CMD6 [%u]=%u: switch error, status 0x%x\n", index, value, r1);
+			return EIO;
+		}
+		if (R1_STATE(r1) == R1_STATE_TRAN) {
+			return 0;
+		}
+		if (mach_absolute_time() > end) {
+			printf("SWEET SDHC: CMD6 [%u]=%u: card stuck in state %u\n", index, value, R1_STATE(r1));
+			return ETIMEDOUT;
+		}
+		delay(100);
+	}
+}
+
+/* Re-read EXT_CSD in the current mode: the read-only part must match the 1-bit copy. */
+static int
+verify_ext_csd(void)
+{
+	int error = sd_read(8, 0, 1);
+	if (error) {
+		return error;
+	}
+	return memcmp(bounce() + EXT_CSD_PROPS, sd.props, sizeof(sd.props)) ? EIO : 0;
+}
+
+static void
+set_host_ctl(uint32_t set, uint32_t clear)
+{
+	sd_wr(SDHCI_HOST_CONTROL, (sd_rd(SDHCI_HOST_CONTROL) & ~clear) | set);
+}
+
+static void
+sd_speed_up(const uint8_t *ext_csd)
+{
+	uint32_t speed = 2;
+	PE_parse_boot_argn("sdhcspeed", &speed, sizeof(speed));
+	memcpy(sd.props, ext_csd + EXT_CSD_PROPS, sizeof(sd.props));
+	uint8_t types = ext_csd[EXT_CSD_DEVICE_TYPE];
+	sd.mode = "1-bit legacy";
+	if (speed < 1) {
+		return;
+	}
+
+	int error = mmc_switch(EXT_CSD_BUS_WIDTH, 2);   /* 8-bit SDR */
+	if (!error) {
+		set_host_ctl(HCTL_8BIT, 0);
+		error = verify_ext_csd();
+		if (error) {
+			printf("SWEET SDHC: 8-bit bus does not verify (%d, int 0x%x): back to 1-bit\n",
+			    error, sd.last_int);
+			set_host_ctl(0, HCTL_8BIT);
+			(void)mmc_switch(EXT_CSD_BUS_WIDTH, 0);
+			return;
+		}
+	} else {
+		printf("SWEET SDHC: switch to 8-bit failed: %d, int 0x%x\n", error, sd.last_int);
+		return;
+	}
+	sd.mode = "8-bit legacy";
+	if (speed < 2) {
+		return;
+	}
+	if (!(types & DEVICE_TYPE_HS52)) {
+		printf("SWEET SDHC: card device type 0x%x has no HS52\n", types);
+		return;
+	}
+
+	error = mmc_switch(EXT_CSD_HS_TIMING, 1);       /* High Speed */
+	if (!error) {
+		set_host_ctl(HCTL_HISPD, 0);
+		error = set_clock(52000);
+		if (!error) {
+			error = verify_ext_csd();
+		}
+		if (error) {
+			printf("SWEET SDHC: HS52 does not verify (%d, int 0x%x): back to legacy speed\n",
+			    error, sd.last_int);
+			set_clock(25000);
+			set_host_ctl(0, HCTL_HISPD);
+			(void)mmc_switch(EXT_CSD_HS_TIMING, 0);
+			return;
+		}
+	} else {
+		printf("SWEET SDHC: switch to HS52 failed: %d, int 0x%x\n", error, sd.last_int);
+		return;
+	}
+	sd.mode = "8-bit HS52";
+}
