+/* ---- GPU VA window ---- */
+/* A 4 KiB table from a write-combining pool; *pa gets its physical address. */
+static uint64_t *
+pt4k(uint64_t *pa)
+{
+	static uint8_t *pool_va;
+	static uint64_t pool_pa;
+	static unsigned pool_left;
+	if (pool_left == 0) {
+		vm_offset_t dma = 0;
+		if (kmem_alloc_contig(kernel_map, &dma, PAGE_SIZE, PAGE_MASK, 0, 0,
+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return NULL;
+		}
+		uint64_t p = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)dma));
+		if (p == 0) {
+			return NULL;
+		}
+		pool_pa = p;
+		pool_va = (uint8_t *)dma;
+		pool_left = PAGE_SIZE / 4096;
+	}
+	unsigned i = PAGE_SIZE / 4096 - pool_left--;
+	*pa = pool_pa + i * 4096;
+	return (uint64_t *)(pool_va + i * 4096);
+}
+
+static bool
+vm_init(void)
+{
+	g_maps = kalloc_data(VM_MAPS * sizeof(g_maps[0]), Z_WAITOK | Z_ZERO);
+	g_owner = kalloc_data(GVA_PAGES * sizeof(g_owner[0]), Z_WAITOK | Z_ZERO);
+	g_l2 = pt4k(&g_l2_pa);
+	if (g_maps == NULL || g_owner == NULL || g_l2 == NULL) {
+		return false;
+	}
+	bzero(g_l2, 4096);
+	flush_dcache64((addr64_t)g_l2_pa, 4096, FALSE);
+	g_boot.l1[GVA_L1] = g_l2_pa | 3u;		/* L1[2] -> L2 (table) */
+	__asm__ volatile("dsb sy" ::: "memory");	/* l1 is write-combining */
+	smmu_tlb_flush();
+	return true;
+}
+
+/* VM lock held: first page of a free run of n pages (first fit from a rover), or -1. */
+static int64_t
+vm_find(uint32_t n)
+{
+	for (int pass = 0; pass < 2; pass++) {
+		uint32_t start = pass ? 0 : g_rover, end = pass ? g_rover : GVA_PAGES;
+		uint32_t run = 0;
+		for (uint32_t p = start; p < end; p++) {
+			run = g_owner[p] ? 0 : run + 1;
+			if (run == n) {
+				return p + 1 - n;
+			}
+		}
+	}
+	return -1;
+}
+
+/* VM lock held: ensure L3 tables exist for pages [first, first + n). */
+static bool
+vm_tables(uint32_t first, uint32_t n)
+{
+	uint32_t per = (2u << 20) / PAGE_SIZE;		/* pages per 2 MiB chunk */
+	for (uint32_t c = first / per; c <= (first + n - 1) / per; c++) {
+		if (g_l3[c] != NULL) {
+			continue;
+		}
+		uint64_t l3pa;
+		g_l3[c] = pt4k(&l3pa);
+		if (g_l3[c] == NULL) {
+			return false;
+		}
+		bzero(g_l3[c], 4096);
+		flush_dcache64((addr64_t)l3pa, 4096, FALSE);
+		g_l2[c] = l3pa | 3u;
+		flush_dcache64((addr64_t)(g_l2_pa + c * 8), 8, FALSE);
+	}
+	return true;
+}
+
+/* VM lock held: write (pa != NULL) or clear the L3 entries of pages [first, first + n). */
+static void
+vm_ptes(uint32_t first, uint32_t n, const uint64_t *pa, bool readonly)
+{
+	uint32_t sub = PAGE_SIZE / 4096;
+	uint64_t attrs = PTE_ATTRS | (readonly ? 1u << 7 : 0);	/* AP[2]: read-only */
+	uint64_t i0 = (uint64_t)first * sub, i1 = (uint64_t)(first + n) * sub;
+	for (uint64_t i = i0; i < i1; i++) {
+		uint32_t c = (uint32_t)(i / 512);
+		g_l3[c][i % 512] = pa ? (pa[i / sub - first] + (i % sub) * 4096) | 3u | attrs : 0;
+	}
+	for (uint64_t c = i0 / 512; c <= (i1 - 1) / 512; c++) {
+		uint64_t l3pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)g_l3[c]));
+		flush_dcache64((addr64_t)l3pa, 4096, FALSE);
+	}
 }
 
