+	uint32_t *dst = (uint32_t *)(sec_mem + 0x1200);	/* 2 x struct dest_vm_and_perm_info (24 B) */
+	uint64_t *ext = (uint64_t *)(sec_mem + 0x2000);	/* args[3..9] */
