+/*
+ * SWEET touch screen for the Pixel 3a (sargo): Synaptics S3706B (RMI4) at
+ * 0x20 on gpio6/7, reset gpio99, attention gpio125 (Linux
+ * sdm670-google-sargo / docs/SARGO.md).
+ *
+ * The bus is i2c9 (QUP wrapper 1 SE1), but that SE is in GSI mode (FIFO
+ * interface disabled) and its GPI DMA engine stopped the SoC in every shim
+ * test, so this driver bit-bangs I2C on the two pins as plain TLMM GPIOs,
+ * as shim probe t09 did. ABL leaves the IC unpowered: its 1.8 V switch is
+ * PM660 GPIO 12, turned on here through the SPMI PMIC arbiter (v5).
+ * PMIC writes: only GPIO 12's mode, output source and enable registers,
+ * and only after its TYPE reads 0x10 (GPIO) and its APID belongs to the
+ * apps EE. IC writes: the RMI4 page select (0xff = 0).
+ *
+ * One kernel thread polls every 10 ms. It reads the F12 objects when the
+ * attention line is low, while a finger is down, and every 100 ms in case
+ * the line is not wired as expected. Object n of the F12 data is 8 bytes:
+ * type (1 finger, 2 stylus), x lo/hi, y lo/hi, z, wx, wy, in panel pixels
+ * (t09: 0x244/0x6e6 for a thumb at the lower middle of 1080x2220).
+ * Boot-arg sargotouch=0 disables it.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void sweet_sargo_touch_init(void);
+
+#define ST_TLMM_PA      0x03900000u     /* TLMM NORTH */
+#define ST_TLMM_SIZE    0x7e000u        /* through gpio125 */
+#define ST_CFG(n)       ((uint32_t)(n) * 0x1000u)
+#define ST_IO(n)        (ST_CFG(n) + 4u)
+#define ST_SDA          6
+#define ST_SCL          7
+#define ST_RESET        99
+#define ST_IRQ          125
+#define ST_ADDR         0x20
+#define ST_FINGERS      5
+#define ST_HALF_NS      2500            /* ~200 kHz SCL */
+
+#define SPMI_CORE_PA    0x0c440000u
+#define SPMI_CHNLS_PA   0x0c600000u
+#define SPMI_OBS_PA     0x0e600000u
+#define SPMI_CNFG_PA    0x0c40a000u
+#define ST_PMIC_PPID    0x0cbu          /* PM660 (SID 0) GPIO 12 */
+#define ST_NO_APID      0xffffu
+
+static vm_offset_t st_tlmm, st_core, st_cnfg, st_obs, st_chnl;
+static uint16_t st_apid = ST_NO_APID;
+static bool st_started;
+static int st_sleep_chan;
+static uint8_t st_f01d, st_f12d;
+
+static uint32_t
+st_rd(vm_offset_t a)
+{
+	uint32_t v = *(volatile uint32_t *)a;
+	__asm__ volatile("dmb osh" ::: "memory");
+	return v;
+}
+
+static void
+st_wr(vm_offset_t a, uint32_t v)
+{
+	__asm__ volatile("dmb osh" ::: "memory");
+	*(volatile uint32_t *)a = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+st_ndelay(uint32_t ns)
+{
+	uint64_t abs, end;
+	nanoseconds_to_absolutetime(ns, &abs);
+	end = mach_absolute_time() + (abs ? abs : 1);
+	while (mach_absolute_time() < end) {
+	}
+}
+
+static void
+st_msleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&st_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* ---- SPMI (PMIC arbiter v5), as in Linux spmi-pmic-arb.c ---- */
+
+static int
+spmi_cmd(vm_offset_t ch, uint32_t cmd, uint32_t *status)
+{
+	st_wr(ch, cmd);
+	for (unsigned i = 0; i < 1000; i++) {
+		uint32_t s = st_rd(ch + 0x08u);
+		if (s & 1u) {
+			*status = s;
+			return (s & 0x0eu) ? -1 : 0;
+		}
+		delay(1);
+	}
+	*status = 0;
+	return -1;
+}
+
+static int
+spmi_read(uint8_t reg, uint8_t *v)
+{
+	vm_offset_t ch = st_obs + 0x80u * st_apid;      /* EE 0 observer */
+	uint32_t s;
+	if (spmi_cmd(ch, (1u << 27) | ((uint32_t)reg << 4), &s)) {    /* EXT_READL */
+		return -1;
+	}
+	*v = (uint8_t)st_rd(ch + 0x18u);
+	return 0;
+}
+
+static int
+spmi_write(uint8_t reg, uint8_t v)
+{
+	uint32_t s;
+	st_wr(st_chnl + 0x10u, v);
+	if (spmi_cmd(st_chnl, (uint32_t)reg << 4, &s)) {               /* EXT_WRITEL */
+		printf("SWEET SARGO TOUCH: PMIC write %#x failed, status %#x\n", reg, s);
+		return -1;
+	}
+	return 0;
+}
+
+static bool
+st_power_on(void)
+{
+	st_core = ml_io_map(SPMI_CORE_PA, 0x2000);
+	st_cnfg = ml_io_map(SPMI_CNFG_PA, 0x1000);
+	st_obs = ml_io_map(SPMI_OBS_PA, 0x10000);
+	if (!st_core || !st_cnfg || !st_obs) {
+		return false;
+	}
+	uint32_t ver = st_rd(st_core), count = st_rd(st_core + 4u) & 0x7ffu, owner = 7;
+	if (ver < 0x50000000u || ver >= 0x70000000u || count == 0 || count > 512) {
+		printf("SWEET SARGO TOUCH: unsupported SPMI arbiter %#x (%u APIDs)\n", ver, count);
+		return false;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		uint32_t map = st_rd(st_core + 0x900u + 4u * i);
+		if (map == 0 || ((map >> 8) & 0xfffu) != ST_PMIC_PPID) {
+			continue;
+		}
+		uint32_t o = st_rd(st_cnfg + 0x700u + 4u * i) & 7u;
+		if (st_apid == ST_NO_APID || o == 0) {
+			st_apid = (uint16_t)i;
+			owner = o;
+		}
+	}
+	uint8_t type = 0, sub = 0;
+	if (st_apid == ST_NO_APID || owner != 0 ||
+	    spmi_read(0x04, &type) || spmi_read(0x05, &sub) || type != 0x10) {
+		printf("SWEET SARGO TOUCH: PM660 GPIO 12 apid %u owner %u type %#x: not touched\n",
+		    st_apid, owner, type);
+		return false;
+	}
+	st_chnl = ml_io_map(SPMI_CHNLS_PA + 0x10000u * st_apid, 0x1000);
+	if (!st_chnl) {
+		return false;
+	}
+	int err = 0;
+	if (sub >= 0x10) {                      /* LV/MV GPIO */
+		err |= spmi_write(0x40, 0x01);  /* digital output */
+		err |= spmi_write(0x44, 0x80);  /* inverted constant low = high */
+	} else {
+		err |= spmi_write(0x40, 0x11);
+	}
+	err |= spmi_write(0x46, 0x80);          /* enable */
+	uint8_t mode = 0, src = 0, en = 0;
+	spmi_read(0x40, &mode);
+	spmi_read(0x44, &src);
+	spmi_read(0x46, &en);
+	printf("SWEET SARGO TOUCH: PM660 GPIO 12 (1.8 V) on: subtype %#x mode %#x src %#x en %#x\n",
+	    sub, mode, src, en);
+	return err == 0;
+}
+
+/* ---- bit-banged I2C on gpio6/7 (open drain: output low or input pulled up) ---- */
+
+static void
+pin_low(unsigned pin)
+{
+	st_wr(st_tlmm + ST_IO(pin), st_rd(st_tlmm + ST_IO(pin)) & ~2u);
+	st_wr(st_tlmm + ST_CFG(pin), (st_rd(st_tlmm + ST_CFG(pin)) & ~0x3ffu) | 3u | (1u << 6) | 0x200u);
+}
+
+static void
+pin_release(unsigned pin)
+{
+	st_wr(st_tlmm + ST_CFG(pin), (st_rd(st_tlmm + ST_CFG(pin)) & ~0x3ffu) | 3u | (1u << 6));
+}
+
+static int
+pin_get(unsigned pin)
+{
+	return st_rd(st_tlmm + ST_IO(pin)) & 1u;
+}
+
+static void
+pin_out(unsigned pin, int high)
+{
+	st_wr(st_tlmm + ST_IO(pin), (st_rd(st_tlmm + ST_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	st_wr(st_tlmm + ST_CFG(pin), (st_rd(st_tlmm + ST_CFG(pin)) & ~0x3ffu) | (1u << 6) | 0x200u);
+}
+
+static bool
+scl_high(void)
+{
+	pin_release(ST_SCL);
+	for (unsigned i = 0; i < 20000 && !pin_get(ST_SCL); i++) {      /* clock stretching */
+		st_ndelay(1000);
+	}
+	return pin_get(ST_SCL);
+}
+
+static void
+i2c_start(void)
+{
+	pin_release(ST_SDA);
+	scl_high();
+	st_ndelay(ST_HALF_NS);
+	pin_low(ST_SDA);
+	st_ndelay(ST_HALF_NS);
+	pin_low(ST_SCL);
+}
+
+static void
+i2c_stop(void)
+{
+	pin_low(ST_SDA);
+	st_ndelay(ST_HALF_NS);
+	scl_high();
+	st_ndelay(ST_HALF_NS);
+	pin_release(ST_SDA);
+	st_ndelay(ST_HALF_NS);
+}
+
+static int
+i2c_put(uint8_t b)
+{
+	for (int i = 7; i >= 0; i--) {
+		if (b & (1u << i)) {
+			pin_release(ST_SDA);
+		} else {
+			pin_low(ST_SDA);
+		}
+		st_ndelay(ST_HALF_NS);
+		scl_high();
+		st_ndelay(ST_HALF_NS);
+		pin_low(ST_SCL);
+	}
+	pin_release(ST_SDA);
+	st_ndelay(ST_HALF_NS);
+	scl_high();
+	int nack = pin_get(ST_SDA);
+	st_ndelay(ST_HALF_NS);
+	pin_low(ST_SCL);
+	return nack;
+}
+
+static uint8_t
+i2c_get(bool ack)
+{
+	uint8_t b = 0;
+	pin_release(ST_SDA);
+	for (int i = 0; i < 8; i++) {
+		st_ndelay(ST_HALF_NS);
+		scl_high();
+		b = (uint8_t)(b << 1 | pin_get(ST_SDA));
+		st_ndelay(ST_HALF_NS);
+		pin_low(ST_SCL);
+	}
+	if (ack) {
+		pin_low(ST_SDA);
+	}
+	st_ndelay(ST_HALF_NS);
+	scl_high();
+	st_ndelay(ST_HALF_NS);
+	pin_low(ST_SCL);
+	pin_release(ST_SDA);
+	return b;
+}
+
+static bool
+rmi_read(uint8_t reg, uint8_t *buf, unsigned len)
+{
+	i2c_start();
+	if (i2c_put(ST_ADDR << 1) || i2c_put(reg)) {
+		i2c_stop();
+		return false;
+	}
+	i2c_start();
+	if (i2c_put(ST_ADDR << 1 | 1)) {
+		i2c_stop();
+		return false;
+	}
+	for (unsigned i = 0; i < len; i++) {
+		buf[i] = i2c_get(i + 1 < len);
+	}
+	i2c_stop();
+	return true;
+}
+
+static bool
+rmi_write1(uint8_t reg, uint8_t v)
+{
+	i2c_start();
+	bool ok = !i2c_put(ST_ADDR << 1) && !i2c_put(reg) && !i2c_put(v);
+	i2c_stop();
+	return ok;
+}
+
+static bool
+st_ic_init(void)
+{
+	pin_release(ST_SDA);
+	pin_release(ST_SCL);
+	/* attention: input, pull-up */
+	st_wr(st_tlmm + ST_CFG(ST_IRQ), (st_rd(st_tlmm + ST_CFG(ST_IRQ)) & ~0x3ffu) | 3u | (1u << 6));
+	pin_out(ST_RESET, 0);
+	st_msleep(10);
+	pin_out(ST_RESET, 1);
+	st_msleep(200);                         /* syna,startup-delay-ms */
+	if (!pin_get(ST_SDA) || !pin_get(ST_SCL)) {
+		printf("SWEET SARGO TOUCH: SDA/SCL low after power-on\n");
+		return false;
+	}
+	for (int i = 0; i < 9 && !pin_get(ST_SDA); i++) {      /* bus recovery */
+		pin_low(ST_SCL);
+		st_ndelay(ST_HALF_NS);
+		scl_high();
+		st_ndelay(ST_HALF_NS);
+	}
+	i2c_stop();
+	if (!rmi_write1(0xff, 0)) {
+		printf("SWEET SARGO TOUCH: no ACK at 0x%x\n", ST_ADDR);
+		return false;
+	}
+	/*
+	 * Page Description Table: entries of 6 bytes (query, cmd, ctrl, data,
+	 * irq count/version, function) at 0xe9, 0xe3, ... until function 0.
+	 */
+	uint8_t e[6];
+	for (int reg = 0xe9; reg >= 0x0a; reg -= 6) {
+		if (!rmi_read((uint8_t)reg, e, 6) || e[5] == 0 || e[5] == 0xff) {
+			break;
+		}
+		if (e[5] == 0x01) {
+			st_f01d = e[3];
+		} else if (e[5] == 0x12) {
+			st_f12d = e[3];
+		}
+	}
+	if (!st_f12d) {
+		printf("SWEET SARGO TOUCH: no F12 in the PDT\n");
+		return false;
+	}
+	printf("SWEET SARGO TOUCH: RMI4 F01 data %#x, F12 data %#x, polling 10 ms\n",
+	    st_f01d, st_f12d);
+	return true;
+}
+
+static void
+st_thread(void *arg, wait_result_t result)
+{
+	bool down[ST_FINGERS] = {false};
+	unsigned tick = 0, errors = 0;
+	(void)arg;
+	(void)result;
+
+	if (!st_power_on()) {
+		return;
+	}
+	st_msleep(20);
+	if (!st_ic_init()) {
+		return;
+	}
+	for (;;) {
+		bool any = false;
+		for (int i = 0; i < ST_FINGERS; i++) {
+			any |= down[i];
+		}
+		if (any || !pin_get(ST_IRQ) || (tick++ % 10u) == 0) {
+			uint8_t d[8 * ST_FINGERS], irq;
+			if (st_f01d) {
+				(void)rmi_read((uint8_t)(st_f01d + 1), &irq, 1);  /* clears attention */
+			}
+			if (!rmi_read(st_f12d, d, sizeof(d))) {
+				if ((errors++ % 500u) == 0) {
+					printf("SWEET SARGO TOUCH: read error (%u)\n", errors);
+				}
+			} else {
+				for (int i = 0; i < ST_FINGERS; i++) {
+					const uint8_t *o = &d[8 * i];
+					bool now = o[0] == 1 || o[0] == 2;
+					if (now || down[i]) {
+						sweet_hid_touch(i, now, o[1] | o[2] << 8, o[3] | o[4] << 8);
+					}
+					down[i] = now;
+				}
+			}
+		}
+		st_msleep(10);
+	}
+}
+
+void
+sweet_sargo_touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+
+	if (st_started) {
+		return;
+	}
+	st_started = true;
+	(void)PE_parse_boot_argn("sargotouch", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET SARGO TOUCH: disabled (sargotouch=0)\n");
+		return;
+	}
+	st_tlmm = ml_io_map(ST_TLMM_PA, ST_TLMM_SIZE);
+	if (!st_tlmm) {
+		printf("SWEET SARGO TOUCH: TLMM mapping failed\n");
+		return;
+	}
+	if (kernel_thread_start(st_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
